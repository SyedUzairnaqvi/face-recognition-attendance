# Environment configuration

# Copy this file to `.env` for local development.
# Never commit `.env`, passwords, API keys, or production credentials.

# MySQL database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=secure_vision
MYSQL_USER=secure_vision_app
MYSQL_PASSWORD=

# Upload limits
MAX_UPLOAD_BYTES=5000000
MAX_VIDEO_UPLOAD_BYTES=50000000
MAX_VIDEO_SECONDS=120
VIDEO_SAMPLE_FPS=1

# Recognition
EMBEDDING_MODEL_NAME=Facenet512
EMBEDDING_DISTANCE_THRESHOLD=0.375

# Image quality
QUALITY_BLUR_THRESHOLD=40
MIN_BRIGHTNESS=35
MAX_BRIGHTNESS=225

# Liveness / anti-spoofing
# Validated locally with DeepFace anti-spoofing.
LIVENESS_ENABLED=true

# For a deployment where liveness has not been validated yet,
# explicitly set LIVENESS_ENABLED=false instead.
